{
  "name": "pwa",
  "private": true,
  "license": "MIT",
  "author": "Edward Coleridge Smith <edcoleridgesmith@gmail.com>",
  "type": "module",
  "version": "0.0.1",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node -e \"require('node:fs').writeFileSync('dist/.gitkeep', '')\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --maxWorkers=4",
    "test:e2e": "playwright test --workers=2",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run test:e2e && npm run build",
    "prepare": "svelte-kit sync && simple-git-hooks"
  },
  "engines": {
    "node": ">=22.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@nearhost/api": "0.17.0-beta.3",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.34",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,svelte}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,html,md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
